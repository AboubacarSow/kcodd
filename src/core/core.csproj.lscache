version=2.2

# This file caches language service data to improve the performance of C# Dev Kit.
# It is not intended for manual editing. It can safely be deleted and will be
# regenerated automatically. For more information, see https://aka.ms/lscache
#
# To control where cache files are stored, use the following VS Code setting:
#   "dotnet.projectsystem.cacheInProjectFolder": true

[project]
project=core.csproj
language=C#
primary
lastDtbSucceeded

[properties]
AssemblyName=core
BaseIntermediateOutputPath=obj/
BaseOutputPath=bin/
MaxSupportedLangVersion=13.0
OutputType=Library
ProjectAssetsFile=<PATH>obj/project.assets.json
RootNamespace= Core
TargetFramework=net9.0
TargetFrameworkIdentifier=.NETCoreApp
TargetFrameworkVersion=v9.0
TargetPath=<PATH>bin/Debug/net9.0/core.dll
TargetRefPath=<PATH>obj/Debug/net9.0/ref/core.dll
TemporaryDependencyNodeTargetIdentifier=net9.0

[commandLineArguments]
/noconfig
/unsafe-
/checked-
/nowarn:1701,1702,1701,1702,8002
/fullpaths
/nostdlib+
/errorreport:prompt
/warn:9
/define:TRACE;DEBUG;NET;NET9_0;NETCOREAPP;NET5_0_OR_GREATER;NET6_0_OR_GREATER;NET7_0_OR_GREATER;NET8_0_OR_GREATER;NET9_0_OR_GREATER;NETCOREAPP1_0_OR_GREATER;NETCOREAPP1_1_OR_GREATER;NETCOREAPP2_0_OR_GREATER;NETCOREAPP2_1_OR_GREATER;NETCOREAPP2_2_OR_GREATER;NETCOREAPP3_0_OR_GREATER;NETCOREAPP3_1_OR_GREATER
/highentropyva+
/nullable:enable
/debug+
/debug:portable
/filealign:512
/optimize-
/out:obj/Debug/net9.0/core.dll
/refout:obj/Debug/net9.0/refint/core.dll
/target:library
/warnaserror-
/utf8output
/deterministic+
/langversion:13.0
/skipanalyzers+
/features:run-nullable-analysis=never
/warnaserror+:NU1605,SYSLIB0011

[sourceFiles]
Nodes/
 AndNode.cs
 CartesienProductNode.cs
 ComparisonNode.cs
 ConditionNode.cs
 DifferenceNode.cs
 DivisionNode.cs
 ExpressionNode.cs
 FullOuterJoinNode.cs
 IntersectionNode.cs
 JoinNode.cs
 LeftOuterJoinNode.cs
 NaturalJoinNode.cs
 NotNode.cs
 OrNode.cs
 OuterJoinNode.cs
 ProjectionNode.cs
 RelationNode.cs
 RenameNode.cs
 RightOuterJoinNode.cs
 SelectionNode.cs
 ThetaJoinNode.cs
 UnionNode.cs
obj/Debug/net9.0/
 .NETCoreApp,Version=v9.0.AssemblyAttributes.cs
 core.AssemblyInfo.cs
 core.GlobalUsings.g.cs

[frameworkPacks]
Microsoft.NETCore.App.Ref

[metadataReferences]

[analyzerReferences]
<NETSDK>/Sdks/Microsoft.NET.Sdk/analyzers/
 Microsoft.CodeAnalysis.CSharp.NetAnalyzers.dll
 Microsoft.CodeAnalysis.NetAnalyzers.dll

[sdkAnalyzerConfigPolicy]
Microsoft.NET.Sdk/analyzers

[analyzerConfigFiles]
../../.editorconfig
obj/Debug/net9.0/core.GeneratedMSBuildEditorConfig.editorconfig

[projectReferences]

[capabilities]
NativeAOT
Pack
SupportsHotReload
