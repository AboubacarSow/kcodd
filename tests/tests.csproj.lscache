#   "dotnet.projectsystem.cacheInProjectFolder": true

[project]
project=tests.csproj
language=C#
primary
lastDtbSucceeded

[properties]
AssemblyName=tests
BaseIntermediateOutputPath=obj/
BaseOutputPath=bin/
IsTestProject=true
MaxSupportedLangVersion=13.0
OutputType=Exe
ProjectAssetsFile=<PATH>obj/project.assets.json
RootNamespace=tests
TargetFramework=net9.0
TargetFrameworkIdentifier=.NETCoreApp
TargetFrameworkVersion=v9.0
TargetPath=<PATH>bin/Debug/net9.0/tests.dll
TargetRefPath=<PATH>obj/Debug/net9.0/ref/tests.dll
TemporaryDependencyNodeTargetIdentifier=net9.0

[commandLineArguments]
/noconfig
/unsafe-
/checked-
/nowarn:1701,1702,1701,1702,8002
/fullpaths
/nostdlib+
/errorreport:prompt
/warn:9
/define:TRACE;DEBUG;NET;NET9_0;NETCOREAPP;NET5_0_OR_GREATER;NET6_0_OR_GREATER;NET7_0_OR_GREATER;NET8_0_OR_GREATER;NET9_0_OR_GREATER;NETCOREAPP1_0_OR_GREATER;NETCOREAPP1_1_OR_GREATER;NETCOREAPP2_0_OR_GREATER;NETCOREAPP2_1_OR_GREATER;NETCOREAPP2_2_OR_GREATER;NETCOREAPP3_0_OR_GREATER;NETCOREAPP3_1_OR_GREATER
/highentropyva+
/nullable:enable
/debug+
/debug:portable
/filealign:512
/optimize-
/out:obj/Debug/net9.0/tests.dll
/refout:obj/Debug/net9.0/refint/tests.dll
/target:exe
/warnaserror-
/utf8output
/deterministic+
/langversion:13.0
/skipanalyzers+
/features:run-nullable-analysis=never
/warnaserror+:NU1605,SYSLIB0011

